# ── Local Hardhat node (primary, no faucet required) ─────────────────────────
# Leave POLYGON_AMOY_RPC and DEPLOYER_PRIVATE_KEY empty for local-only usage.

# ── Optional: Polygon Amoy testnet ───────────────────────────────────────────
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=

# ── Gas reporter (optional) ───────────────────────────────────────────────────
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# ── Etherscan / Polygonscan verification (optional) ───────────────────────────
POLYGONSCAN_API_KEY=
